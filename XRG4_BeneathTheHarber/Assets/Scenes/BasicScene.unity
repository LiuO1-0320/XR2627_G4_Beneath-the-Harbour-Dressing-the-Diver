  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 91a975382f6b4f48a68bd214c1fb8f10, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  wearable: {fileID: 750000005}
  font: {fileID: 0}
  instructions: "\u8BD5\u6234\u6F5C\u6C34\u5934\u76D4 / Try the diving helmet\n\u6309\u4F4F\u63E1\u628A\u6293\u53D6
    \u2192 \u79FB\u5230\u5934\u90E8\u9644\u8FD1 \u2192 \u677E\u5F00\u4F69\u6234\nHold
    grip \u2192 bring to your head \u2192 release\n\u6309 B / Y \u53D6\u4E0B\u5E76\u653E\u56DE\u5C55\u53F0
    / Return to stand"
  successMessage: "\u4F69\u6234\u6210\u529F\uFF01 / Helmet equipped!\n\u6309 B /
    Y \u53EF\u53D6\u4E0B\u5934\u76D4"
  fontSize: 34
  successDuration: 3

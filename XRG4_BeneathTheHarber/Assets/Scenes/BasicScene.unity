--- !u!114 &1248627908
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1248627906}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 62a9f61db8cd49f490e589d98608a102, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  title: "\u94DC\u5236\u6F5C\u6C34\u5934\u76D4Brass diving helmet"
  introduction: "\u4F20\u7EDF\u6F5C\u6C34\u5934\u76D4\u5E38\u7531\u94DC\u4E0E\u9EC4\u94DC\u5236\u6210\uFF0C\u5E76\u914D\u6709\u73BB\u7483\u89C6\u7A97\u3002\u5934\u76D4\u4E0E\u80F8\u80A9\u6258\u67B6\u3001\u9632\u6C34\u6F5C\u6C34\u670D\u8FDE\u63A5\uFF0C\u6784\u6210\u6C34\u9762\u4F9B\u6C14\u6F5C\u6C34\u88C5\u5907\u7684\u4E00\u90E8\u5206\u3002\r\n\u6F5C\u6C34\u5458\u901A\u8FC7\u8FDE\u63A5\u6C34\u9762\u6C14\u6CF5\u7684\u8F6F\u7BA1\u83B7\u5F97\u7A7A\u6C14\uFF0C\u5E76\u900F\u8FC7\u89C6\u7A97\u89C2\u5BDF\u5468\u56F4\u73AF\u5883\u3002\r\n\u4ED4\u7EC6\u89C2\u5BDF\u5934\u76D4\u7684\u91D1\u5C5E\u5916\u58F3\u3001\u89C6\u7A97\u548C\u8FDE\u63A5\u90E8\u4F4D\uFF1A\u5B83\u4EEC\u5982\u4F55\u5E2E\u52A9\u6F5C\u6C34\u5458\u5728\u6C34\u4E0B\u5DE5\u4F5C\uFF1F\r\n\u672C\u8BF4\u660E\u4ECB\u7ECD\u4F20\u7EDF\u94DC\u5236\u6F5C\u6C34\u5934\u76D4\u7684\u4E00\u822C\u7ED3\u6784\uFF0C\u5177\u4F53\u578B\u53F7\u7684\u8BBE\u8BA1\u53EF\u80FD\u4E0D\u540C\u3002\r\n\r\nTraditional
    diving helmets are typically made of copper and brass, and are fitted with glass
    visors. The helmet is connected to a chest and shoulder harness and a waterproof
    diving suit, forming part of a surface-supplied diving system.\r\nDivers receive
    air through a hose connected to a surface air pump and observe their surroundings
    through the visor.\r\nTake a close look at the helmet\u2019s metal shell, viewing
    window and connecting parts: how do they help the diver to work underwater?\r\nThis
    guide outlines the general structure of a traditional copper diving helmet; the
    design of specific models may vary."
  font: {fileID: 0}
  backgroundColor: {r: 0.025, g: 0.09, b: 0.12, a: 0.97}
  textColor: {r: 0.9, g: 0.96, b: 0.96, a: 1}
  accentColor: {r: 0.85, g: 0.52, b: 0.28, a: 1}
  titleFontSize: 52
  bodyFontSize: 32
  size: {x: 2.4, y: 1.8}
  scrollSensitivity: 45

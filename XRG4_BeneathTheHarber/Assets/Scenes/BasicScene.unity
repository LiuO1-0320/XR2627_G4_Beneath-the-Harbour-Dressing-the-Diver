  m_Script: {fileID: 11500000, guid: 62a9f61db8cd49f490e589d98608a102, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  title: Beneath the Harbour
  introduction: "\r \u6B22\u8FCE\u6765\u5230\u6D77\u4E8B\u535A\u7269\u9986\r\n\u63A5\u4E0B\u6765\u6211\u4EEC\u5C06\u901A\u8FC7\u4E00\u4E2A\u7B80\u77ED\u7684\u4EFB\u52A1\u5F15\u5BFC\u6765\u8BA9\u4F60\u5B66\u4E60\u4E86\u89E3\u548C\u201C\u94DC\u5236\u5934\u76D4\u201D\u4EE5\u53CA\u5176\u80CC\u540E\u548C\u9999\u6E2F\u7EF4\u591A\u5229\u4E9A\u6E2F\u6709\u5173\u7684\u5386\u53F2\u6545\u4E8B\u3002\n\r\nWelcome
    to the Maritime Museum\r\nNext, we\u2019ll take you through a short guided tour
    to help you learn about the \u2018Bronze Helmet\u2019 and the historical story
    behind it, which is linked to Victoria Harbour in Hong Kong.\n\n\u73B0\u5728\u4EB2\u5411\u53F3\u8F6C\nnow
    please turn right\n\n"
  font: {fileID: 0}
  backgroundColor: {r: 0.025, g: 0.09, b: 0.12, a: 0.97}
  textColor: {r: 0.9, g: 0.96, b: 0.96, a: 1}
  accentColor: {r: 0.1616826, g: 0.28613055, b: 0.4716981, a: 1}
  titleFontSize: 58
  bodyFontSize: 38
  size: {x: 2.4, y: 1.8}
  scrollSensitivity: 45
